[Unit]
Description=cosmosXmachina private deterministic Python pipelines
After=network.target

[Service]
Type=simple
WorkingDirectory=@COSMOS_ROOT@/current/runtime/python
ExecStart=@COSMOS_ROOT@/shared/venv/bin/python @COSMOS_ROOT@/current/runtime/python/python_service/server.py
Restart=always
RestartSec=5
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
Environment=PYTHONUNBUFFERED=1
Environment=COSMOS_ENV_FILE=@COSMOS_ENV_FILE@
Environment=PYTHON_LAB_PORT=8790
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryHigh=96M
MemoryMax=128M
CPUQuota=60%
TasksMax=24
LimitNOFILE=512

[Install]
WantedBy=multi-user.target
