# Interim protection for the legacy SFTP document root. The canonical Apache
# deployment serves only /opt/cosmosxmachina/current/dist and does not need it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} !^/(?:index\.html|privacy\.html|robots\.txt|sitemap\.xml)$ [NC]
  RewriteCond %{REQUEST_URI} !^/assets/[A-Za-z0-9_./-]+\.(?:css|js|mjs|svg|webp|jpe?g|png|woff2)$ [NC]
  RewriteCond %{REQUEST_URI} !^/portfolio(?:/(?:document-operations|operations-hub|knowledge-assistant|kpi-studio))?/?(?:index\.html)?$ [NC]
  RewriteCond %{REQUEST_URI} !^/api(?:/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
  RewriteRule ^ - [F,L]
</IfModule>
