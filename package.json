{
  "name": "cosmosxmachina-creation-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.js",
    "dev:fixtures": "vite --config vite.config.js --mode fixtures",
    "serve:local": "node scripts/e2e-stack.mjs --local",
    "build": "node scripts/build.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "capture:previews": "node scripts/capture-previews.mjs",
    "report:visits": "node scripts/visit-report.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --outDir dist",
    "start": "node api/server.mjs",
    "test": "npm run test:frontend && npm run test:node && npm run test:python",
    "test:all": "npm test && npm run test:e2e",
    "test:frontend": "vitest run",
    "test:node": "node --test tests/node/*.test.js",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "echarts": "^6.0.0",
    "fastify": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
